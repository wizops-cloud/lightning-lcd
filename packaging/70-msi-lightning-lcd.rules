# MSI RTX 5090 Lightning Z — écran LCD "V530-9.6 Lightning" (ArtInChip USB Display) :
# accès pour l'utilisateur connecté. Doit être trié avant 73-seat-late.rules.
#
# 0db0:7881 est l'écran testé. Les identifiants 0db0:7880 à 0db0:7919, déclarés par le
# pilote Windows pour d'autres cartes, sont aussi ouverts à l'utilisateur ; lightning ne
# les pilote qu'avec l'option explicite --any-supported-pid (non testés).
SUBSYSTEM=="usb", ATTR{idVendor}=="0db0", ATTR{idProduct}=="78[89][0-9]|79[01][0-9]", MODE="0660", TAG+="uaccess"
# Interface HID de commande (protocole BY : conn, extendedDisplay, brightness, rotate)
KERNEL=="hidraw*", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="78[89][0-9]|79[01][0-9]", MODE="0660", TAG+="uaccess"
